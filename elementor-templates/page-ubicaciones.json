        "html": "<div class=\"da-site\">\n<header class=\"da-header\">\n  <div class=\"da-container da-header__bar\">\n    <a class=\"da-logo\" href=\"/inicio/\">\n      <span class=\"da-logo__mark\">DA</span>\n      Don Arturo\n    </a>\n    <nav class=\"da-nav\" id=\"da-nav-main\">\n      <a href=\"/inicio/\">Inicio</a>\n<a href=\"/quienes-somos/\">¿Quiénes Somos?</a>\n<a href=\"/ubicaciones/\" aria-current=\"page\">Ubicaciones</a>\n<a href=\"/servicios/\">Servicios</a>\n<a href=\"/contacto/\">Contacto</a>\n    </nav>\n    <div class=\"da-row\">\n      <a class=\"da-header__cta\" href=\"tel:+50223182222\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M22 16.92v3a2 2 0 0 1-2.18 2 19.8 19.8 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.12.9.34 1.79.65 2.65a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.43-1.43a2 2 0 0 1 2.11-.45c.86.31 1.75.53 2.65.65A2 2 0 0 1 22 16.92z\"/></svg><span>+502 2318-2222</span></a>\n      <button class=\"da-menu-toggle\" aria-controls=\"da-nav-main\" aria-expanded=\"false\" aria-label=\"Abrir menú\"><svg width=\"26\" height=\"26\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M4 7h16M4 12h16M4 17h16\"/></svg></button>\n    </div>\n  </div>\n</header>\n\n<section class=\"da-hero da-glow\" style=\"background:var(--base);\">\n  <div class=\"da-container da-grid da-grid--2\">\n    <div class=\"da-reveal\">\n      <span class=\"da-eyebrow\">Ubicaciones</span>\n      <h1 style=\"font-size:clamp(2.2rem,4.5vw,3rem);\">+160 estaciones de servicio</h1>\n      <p class=\"da-lede\">Estamos presentes en 19 departamentos de Guatemala para servirte productos de alta calidad y que así puedas llegar más lejos. Visítanos y prueba nuestro servicio completo gratis.</p>\n      <a class=\"da-btn da-btn--primary\" href=\"tel:+50223182222\">Llámanos: +502 2318-2222</a>\n    </div>\n    <img c